    <string name="accessibility_service_label">WhisperType</string>
    <string name="accessibility_service_description">WhisperType uses Accessibility to detect when a normal text field is focused and the keyboard is visible, so it can show a small microphone bubble. When you tap Stop, it inserts the dictated text into the focused field. It never reads unrelated screen content and never works in password or secure fields.</string>

