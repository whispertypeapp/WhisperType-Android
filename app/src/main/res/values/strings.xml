    <!-- Studio orientation wizard (1.1.0) -->
    <string name="onboard_welcome_title">Speak. We type it where you already are.</string>
    <string name="onboard_welcome_body">WhisperType keeps your keyboard. A small bubble appears over Messages, Mail, Chrome — tap, talk, tap the check.</string>
    <string name="onboard_how_title">How it works</string>
    <string name="onboard_how_body">Tap the bubble (or the mini-dot) to start. Speak naturally — the waveform shows you are being heard. Tap the green check when you are done.</string>
    <string name="onboard_how_step1">1 · Tap the bubble</string>
    <string name="onboard_how_step23">2 · Speak. 3 · Tap the green check to insert.</string>
    <string name="onboard_overlay_title">Let the bubble sit above other apps</string>
    <string name="onboard_overlay_body">Android calls this “Display over other apps.” Without it the mic cannot appear over your keyboard.</string>
    <string name="onboard_overlay_required">Required · system dialog</string>
    <string name="onboard_allow_overlay">Allow overlay</string>
    <string name="onboard_continue">Continue</string>
    <string name="onboard_skip_for_now">Skip for now</string>
    <string name="onboard_mic_title">Microphone, only while you speak</string>
    <string name="onboard_mic_body">We also show a recording notification so you always know the mic is on. Neither runs in the background when you are idle.</string>
    <string name="onboard_allow_mic">Allow mic and notifications</string>
    <string name="onboard_a11y_why_title">Find the field. Put the words in.</string>
    <string name="onboard_a11y_why_body">Accessibility is how WhisperType sees the cursor and inserts text. It does not scrape the rest of your screen, and it is off in password fields.</string>
    <string name="onboard_a11y_apk_note">Because this app arrived as an APK, Android will likely block the next screen. That is expected. The following steps walk through it.</string>
    <string name="onboard_a11y_try_title">Turn on WhisperType</string>
    <string name="onboard_a11y_try_body">Open Accessibility settings, find WhisperType in the list, and switch it on. Come back here when you are done.</string>
    <string name="onboard_open_accessibility">Open accessibility settings</string>
    <string name="onboard_restricted_title">Restricted setting?</string>
    <string name="onboard_restricted_body">On some phones, sideloaded apps hide the accessibility toggle until you allow restricted settings for WhisperType. If the switch was greyed out, follow the next steps.</string>
    <string name="onboard_appinfo_title">Open App info</string>
    <string name="onboard_appinfo_body">Tap the ⋮ menu on the App info screen, choose Allow restricted settings, confirm with your PIN or fingerprint, then return here.</string>
    <string name="onboard_open_appinfo">Open App info</string>
    <string name="onboard_recovery_title">Don’t see the three dots?</string>
    <string name="onboard_recovery_body">After allowing restricted settings, open Accessibility again and enable WhisperType. If it still will not stick, reboot the phone once — some OEM skins need that.</string>
    <string name="onboard_a11y_enable_title">Enable WhisperType</string>
    <string name="onboard_a11y_enable_body">With restricted settings allowed, turn WhisperType on in the accessibility list.</string>
    <string name="onboard_key_title">Your Gemini key stays on this phone</string>
    <string name="onboard_key_body">Paste once. It is encrypted in the Android Keystore. Audio goes only to Gemini Live. We never log transcripts.</string>
    <string name="onboard_key_source">Create a key at Google AI Studio:</string>
    <string name="onboard_key_source_url">aistudio.google.com/api-keys</string>
    <string name="onboard_key_free_tier">Google\'s free tier works without billing setup and includes unlimited daily tokens for Gemini 3.5 Transcribe Live — the model WhisperType uses for dictation.</string>
    <string name="onboard_open_api_keys">Open API keys page</string>
    <string name="onboard_ready_title">You’re set</string>
    <string name="onboard_ready_hero_sub">Open any app, tap the bubble, speak.</string>
    <string name="onboard_ready_body">If accessibility later turns off, Home shows one banner. The full six gates live in Settings → System.</string>
